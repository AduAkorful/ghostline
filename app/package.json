{
  "name": "ghostline-site",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "prepare": "node scripts/generate.mjs",
    "dev": "node scripts/generate.mjs && npm run agent-files && next dev -p 3100",
    "build": "node scripts/generate.mjs && npm run check:docs && npm run agent-files && next build && node scripts/include-demo.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check:docs": "node --experimental-strip-types scripts/check-docs.ts",
    "agent-files": "node --experimental-strip-types scripts/write-agent-files.ts"
  },
  "dependencies": {
    "@ghostline/sdk": "file:../packages/ghostline",
    "gsap": "3.15.0",
    "marked": "18.1.2",
    "mermaid": "12.2.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "22.x"
  },
  "type": "module"
}
